@baseUrl = http://localhost:5100

### Get the OpenAPI document
GET {{baseUrl}}/openapi/v1.json
Accept: application/json

### Get the latest known position for every track
GET {{baseUrl}}/api/v1/tracks/current
Accept: application/json

### Get the newest 100 alerts
GET {{baseUrl}}/api/v1/alerts?limit=100
Accept: application/json

### Get the newest telemetry history page for a track ID
GET {{baseUrl}}/api/v1/tracks/DRONE-001/history?limit=100
Accept: application/json

### Get the first 20 reports when the dashboard needs a smaller page
GET {{baseUrl}}/api/v1/tracks/DRONE-001/history?limit=20
Accept: application/json

### Get the next older page using nextCursor from the previous response
GET {{baseUrl}}/api/v1/tracks/DRONE-001/history?limit=100&beforeTimestampUtc=2026-10-23T15%3A00%3A00Z&beforeSourceId=COLLECTOR-01
Accept: application/json

### Invalid request: limit must be between 1 and 500 (returns 400)
GET {{baseUrl}}/api/v1/tracks/DRONE-001/history?limit=0
Accept: application/json

### Invalid request: both cursor values are required (returns 400)
GET {{baseUrl}}/api/v1/tracks/DRONE-001/history?beforeTimestampUtc=2026-10-23T15%3A00%3A00Z
Accept: application/json
